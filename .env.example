# Public URL of the site (used for OAuth, Stripe and email links)
APP_URL=https://mflightdriver.com
# Long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# Postgres password for the bundled database (docker-compose)
POSTGRES_PASSWORD=change-me
# First super admin, created on the very first start only
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Manwell
ADMIN_LAST_NAME=Clark
# Optional: lets the seeded demo members sign in with this password
# DEMO_PASSWORD=
# Only when using an external database instead of docker-compose's db:
# DATABASE_URL=postgres://user:pass@host:5432/mflight
# DATABASE_SSL=false
